[Unit]
Description=Caelestia shell on niri (niri-shell caelestia mode)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/niri-shell run-caelestia
Restart=on-failure
RestartSec=1
# en_GB time locale = Monday-first calendar; clock stays 12h via shell.json clockFormat
Environment=LC_TIME=en_GB.UTF-8
